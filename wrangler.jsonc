{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "colours",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "GLOBAL_PULSE_CACHE",
      "id": "551ba00b38a94fd1808387c1d238b3ef"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xiao-colours-db",
      "database_id": "cc41e1e0-aa65-442f-a6e5-929c8e324b7c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
